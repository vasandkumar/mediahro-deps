# libplacebo extras for Apple (on top of ../../flags/libplacebo.flags).
# Vulkan through MoltenVK, linked directly (vk-proc-addr). OpenGL / GLES for
# the libmpv render API; mpv hands libplacebo its GL loader (no gl-proc-addr).
-Dvk-proc-addr=enabled
-Dopengl=enabled
-Dgl-proc-addr=disabled
-Dd3d11=disabled
-Ddovi=enabled
-Dlibdovi=disabled
-Dunwind=disabled
-Dxxhash=disabled
-Dbench=false
-Dfuzz=false
-Ddebug-abort=false
