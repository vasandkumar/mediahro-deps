# mpv meson options (docs/05 §4.1): LGPL build, libmpv only, no scripting. libplacebo is mandatory in mpv 0.41 (no option).
-Dgpl=false
-Dlibmpv=true
-Dcplayer=false
-Dlua=disabled
-Djavascript=disabled
-Dcplugins=disabled
-Dvulkan=enabled
-Dlibarchive=disabled
-Ddvdnav=disabled
-Dcdda=disabled
-Ddvbin=disabled
-Drubberband=disabled
-Dvapoursynth=disabled
-Dlibavdevice=disabled
-Dtests=false
-Dfuzzers=false
-Dmanpage-build=disabled
-Dhtml-build=disabled
-Dpdf-build=disabled
-Ddefault_library=shared
