# FFmpeg configure flags shared by every target (docs/05 §4.1, §10; docs/09 §2).
# LGPL-2.1+: never --enable-gpl, --enable-nonfree or --enable-version3. libpostproc (GPL) no longer exists in FFmpeg 8.
--enable-shared
--disable-static
--disable-programs
--disable-doc
--disable-debug
--disable-avdevice
--disable-autodetect
--disable-openssl
--disable-gnutls
--disable-libtls
--disable-mbedtls
--enable-pic
--enable-hardcoded-tables
# GPL-only sources compiled even without --enable-gpl (found by scripts/source_scan.py):
# perlin.c (perlin filter), qp_table.c (codecview filter), aarch64/crc.S (see patches/ffmpeg).
--disable-filter=perlin
--disable-filter=codecview
--disable-arm-crc
--enable-libdav1d
--enable-libvpx
--enable-libopus
--enable-libopenmpt
--enable-vulkan
--extra-cflags=-D_FORTIFY_SOURCE=2 -fstack-protector-strong
