# mpv on Android (docs/05 §4.1): gpu-next over Vulkan or EGL, MediaCodec, AAudio / OpenSL ES / AudioTrack.
-Dandroid-media-ndk=enabled
-Degl-android=enabled
-Dgl=enabled
-Dplain-gl=enabled
-Dshaderc=enabled
-Daaudio=enabled
-Dopensles=enabled
-Daudiotrack=enabled
-Dlibbluray=enabled
-Duchardet=enabled
-Dlcms2=enabled
-Djpeg=enabled
-Dzlib=enabled
-Diconv=enabled
-Dzimg=disabled
-Dspirv-cross=disabled
-Dx11=disabled
-Dwayland=disabled
-Ddrm=disabled
-Dgbm=disabled
-Dvaapi=disabled
-Dvdpau=disabled
-Dcuda-hwaccel=disabled
-Dcuda-interop=disabled
-Dpulse=disabled
-Dpipewire=disabled
-Dalsa=disabled
-Djack=disabled
-Dopenal=disabled
-Doss-audio=disabled
-Dsndio=disabled
-Dsdl2-audio=disabled
-Dsdl2-video=disabled
-Dsdl2-gamepad=disabled
-Dcaca=disabled
-Dsixel=disabled
