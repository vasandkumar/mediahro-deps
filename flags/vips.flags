# libvips 8.18 (LGPL, dynamic). OS decoders handle HEIC; no libheif on Windows (docs/05 §5, §10).
# libimagequant is GPL-3 and stays off; GIF save needs a permissive quantiser (quantizr), see versions.json cgif note.
-Dheif=disabled
-Dheif-module=disabled
-Dpoppler=disabled
-Dpdfium=disabled
-Dmagick=disabled
-Dopenslide=disabled
-Dmatio=disabled
-Dcfitsio=disabled
-Dfftw=disabled
-Dimagequant=disabled
-Drsvg=disabled
-Dopenjpeg=disabled
-Dnifti=disabled
-Dorc=disabled
-Duhdr=disabled
-Dpangocairo=disabled
-Dfontconfig=disabled
-Dcgif=enabled
-Djpeg=enabled
-Djpeg-xl=enabled
-Djpeg-xl-module=disabled
-Dspng=enabled
-Dpng=disabled
-Dwebp=enabled
-Dtiff=enabled
-Dexif=enabled
-Dlcms=enabled
-Dopenexr=enabled
-Draw=enabled
-Dhighway=enabled
-Darchive=enabled
-Dzlib=enabled
-Dmodules=disabled
-Dintrospection=disabled
-Dvapi=false
-Dcplusplus=false
-Ddeprecated=false
-Dexamples=false
-Ddocs=false
-Dcpp-docs=false
-Ddefault_library=shared
