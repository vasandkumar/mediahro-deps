# libvips 8.18 (LGPL, dynamic). OS decoders handle HEIC; no libheif on Windows (docs/05 §5, §10).
# ImagePipeline (docs/05 §5) routes JPEG, PNG, WebP, TIFF, GIF and EXR to libvips; JPEG XL, AVIF and RAW go to
# libjxl / libavif / LibRaw directly and HEIC to the OS. Install size (docs/11 §5): nothing else is built in.
# libimagequant is GPL-3 and stays off; GIF save needs a permissive quantiser (quantizr), see versions.json cgif note.
-Dheif=disabled
-Dheif-module=disabled
-Dpoppler=disabled
-Dpdfium=disabled
-Dmagick=disabled
-Dopenslide=disabled
-Dmatio=disabled
-Dcfitsio=disabled
-Dfftw=disabled
-Dimagequant=disabled
-Drsvg=disabled
-Dopenjpeg=disabled
-Dnifti=disabled
-Dorc=disabled
-Duhdr=disabled
-Dpangocairo=disabled
-Dfontconfig=disabled
-Dcgif=disabled
-Djpeg=enabled
-Djpeg-xl=disabled
-Djpeg-xl-module=disabled
-Dspng=enabled
-Dpng=disabled
-Dwebp=enabled
-Dtiff=enabled
-Dexif=enabled
-Dlcms=enabled
-Dopenexr=enabled
-Draw=disabled
-Dhighway=enabled
-Darchive=disabled
-Dzlib=enabled
-Dmodules=disabled
-Dintrospection=disabled
-Dvapi=false
-Dcplusplus=false
-Ddeprecated=false
-Dexamples=false
-Ddocs=false
-Dcpp-docs=false
-Ddefault_library=shared
-Dppm=false
-Danalyze=false
-Dradiance=false
-Dnsgif=true
